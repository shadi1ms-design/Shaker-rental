rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTokenRole(roles) {
      return isSignedIn() && ('role' in request.auth.token) && (request.auth.token.role in roles);
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        hasTokenRole(['super_admin', 'superAdmin', 'owner']) ||
        (request.auth.token.keys().hasAny(['super_admin', 'superAdmin', 'owner']) && (
          request.auth.token.get('super_admin', false) == true ||
          request.auth.token.get('superAdmin', false) == true ||
          request.auth.token.get('owner', false) == true
        ))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          hasTokenRole(['admin']) ||
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.get('admin', false) == true)
        )
      );
    }

    function isEmployee() {
      return isAdmin() || (
        isSignedIn() && (
          hasTokenRole(['employee', 'staff', 'manager']) ||
          (request.auth.token.keys().hasAny(['employee', 'staff', 'manager']) && (
            request.auth.token.get('employee', false) == true ||
            request.auth.token.get('staff', false) == true ||
            request.auth.token.get('manager', false) == true
          ))
        )
      );
    }

    // =========================================================================
    // 1. PUBLIC FLEET VEHICLE MEDIA
    // =========================================================================
    // NOTE: `allow write` also covers delete, where request.resource is null; evaluating
    // request.resource.size would error and DENY the delete even for admins. So create/update
    // (which inspect the uploaded object) and delete are declared separately.
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
                    && request.resource.size <= 30 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isAdmin();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
                    && request.resource.size <= 30 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. IDENTITY VERIFICATION VAULT & PENDING (SERVER-AUTHORITATIVE ONLY)
    // =========================================================================
    // Direct client access is strictly DENIED.
    // Uploads and moves occur via Cloud Functions using Admin SDK.
    // Document viewing requires short-lived (60s) signed URLs generated for Admins.
    match /verification_pending/{allPaths=**} {
      allow read, write: if false;
    }

    match /verification_vault/{allPaths=**} {
      allow read, write: if false;
    }

    match /verification_archive/{allPaths=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 3. LEGACY CUSTOMER DOCUMENT PATHS (FROZEN / ADMIN AUDIT ONLY)
    // =========================================================================
    // Direct client writes are forbidden. Ordinary employees cannot access customer documents.
    // Read is strictly restricted to Admins for historical audit; no client create/update/delete.
    match /users/{userId}/documents/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId}/files/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 4. DIGITAL CONTRACTS & VIDEOS (<= 100MB)
    // =========================================================================
    match /contracts/{contractId}/videos/{videoId} {
      allow read: if isEmployee() || (
        isSignedIn() &&
        resource != null &&
        resource.metadata != null &&
        resource.metadata.customerId == request.auth.uid
      );
      allow create, update: if isEmployee()
                    && request.resource.size <= 100 * 1024 * 1024
                    && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if isAdmin();
    }

    match /contracts/{contractId}/{allPaths=**} {
      allow read: if isEmployee() || (
        isSignedIn() &&
        resource != null &&
        resource.metadata != null &&
        resource.metadata.customerId == request.auth.uid
      );
      allow create, update: if isEmployee()
                    && request.resource.size <= 30 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)|application/pdf');
      // Contract evidence (photos / PDFs) can only be removed by admins, not by any staff member.
      allow delete: if isAdmin();
    }

    // Default fallback catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
