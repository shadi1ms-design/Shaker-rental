rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Check token custom claims (Zero-read Role-based Authentication via Firebase Auth Token Claims)
    function hasTokenRole(roles) {
      return isSignedIn() && ('role' in request.auth.token) && (request.auth.token.role in roles);
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        hasTokenRole(['super_admin', 'superAdmin', 'owner']) ||
        (request.auth.token.keys().hasAny(['super_admin', 'superAdmin', 'owner']) && (
          request.auth.token.get('super_admin', false) == true ||
          request.auth.token.get('superAdmin', false) == true ||
          request.auth.token.get('owner', false) == true
        ))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          hasTokenRole(['admin']) ||
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.get('admin', false) == true)
        )
      );
    }

    function isEmployee() {
      return isAdmin() || (
        isSignedIn() && (
          hasTokenRole(['employee', 'staff', 'manager']) ||
          (request.auth.token.keys().hasAny(['employee', 'staff', 'manager']) && (
            request.auth.token.get('employee', false) == true ||
            request.auth.token.get('staff', false) == true ||
            request.auth.token.get('manager', false) == true
          ))
        )
      );
    }

    // Health check and connection test document
    match /test/{docId} {
      allow read, write: if isEmployee();
    }

    // Users collection: users/{userId}
    match /users/{userId} {
      allow read: if isEmployee() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'user']) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['pending', 'manual_review', 'unverified']) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('identityVerified' in request.resource.data) || request.resource.data.identityVerified == false) &&
        (!('verifiedAt' in request.resource.data)) &&
        (!('verifiedBy' in request.resource.data)) &&
        (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted == false) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isStaff' in request.resource.data) || request.resource.data.isStaff == false) &&
        (!('active' in request.resource.data) || request.resource.data.active == true)
      );
      allow update: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'phone', 'photoURL', 'updatedAt', 'email',
          'fcmTokens', 'fcmLastUpdated'
        ])
      ) || isAdmin();
      allow delete: if isAdmin();

      // Subcollection for user files (/users/{userId}/files/{fileId})
      match /files/{fileId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow create: if isAdmin() || (
          isEmailVerified() && request.auth.uid == userId &&
          (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
          (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'manual_review', 'uploaded'])
        );
        allow update: if isAdmin() || (
          isSignedIn() && request.auth.uid == userId &&
          (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.get('verified', false)) &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', 'pending') || request.resource.data.status in ['pending', 'manual_review', 'uploaded'])
        );
        allow delete: if isAdmin() || (
          isSignedIn() && request.auth.uid == userId &&
          resource.data.get('verified', false) != true &&
          resource.data.get('status', 'pending') in ['pending', 'uploaded', 'rejected', 'manual_review']
        );
      }
    }

    // Top-level files index: /files/{fileId}
    match /files/{fileId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isEmailVerified() && request.resource.data.userId == request.auth.uid &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'manual_review', 'uploaded'])
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == request.auth.uid &&
        (!('verified' in request.resource.data) || request.resource.data.verified == resource.data.get('verified', false)) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', 'pending') || request.resource.data.status in ['pending', 'manual_review', 'uploaded'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid &&
        resource.data.get('verified', false) != true &&
        resource.data.get('status', 'pending') in ['pending', 'uploaded', 'rejected', 'manual_review']
      );
    }

    // Settings collection
    match /settings/{settingsId} {
      allow read: if settingsId in ['company', 'global', 'rates'];
      allow write: if isAdmin();
    }

    // Fleet Vehicles collection
    // Public vehicles document CANNOT include plateNumber, currentMileage, lastOilChangeMileage (which belong strictly to internal/details)
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        !request.resource.data.keys().hasAny(['plateNumber', 'currentMileage', 'lastOilChangeMileage']);
      allow delete: if isAdmin();

      match /_internal/{docId} {
        allow read, write: if isAdmin();
      }

      match /internal/{docId} {
        allow read, write: if isEmployee();
      }
    }

    // Bookings collection:
    // Employee updates restricted to operational fields (status, notes, pickup/return dates, deliveryLocation, updatedAt).
    // Prices, totals, paidAmount, paymentStatus, and deletions are strictly managed via Cloud Functions / Admin SDK.
    match /bookings/{bookingId} {
      allow read: if isEmployee() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isEmployee();
      allow update: if (
        isEmployee() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'notes', 'pickupDate', 'returnDate', 'pickupTime', 'returnTime', 'deliveryLocation', 'updatedAt'
        ])
      ) || (
        isSignedIn() && 
        resource.data.customerId == request.auth.uid && 
        resource.data.status in ['new', 'pending', 'reviewing'] &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      ) || (
        isSignedIn() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.status in ['cancelled', 'rejected', 'completed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFromCustomer', 'updatedAt'])
      );
      allow delete: if false; // Hard delete forbidden on bookings
    }

    // Customers CRM collection
    match /customers/{customerId} {
      allow read: if isEmployee() || (isSignedIn() && request.auth.uid == customerId);
      allow create: if isEmployee() || (
        isSignedIn() && 
        request.auth.uid == customerId && 
        request.resource.data.id == customerId &&
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'user']) &&
        (!('totalSpending' in request.resource.data) || request.resource.data.totalSpending == 0) &&
        (!('totalRentals' in request.resource.data) || request.resource.data.totalRentals == 0) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['pending', 'manual_review', 'unverified']) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('verifiedAt' in request.resource.data)) &&
        (!('verifiedBy' in request.resource.data)) &&
        (!('isDeleted' in request.resource.data) || request.resource.data.isDeleted == false) &&
        (!('isBlacklisted' in request.resource.data) || request.resource.data.isBlacklisted == false)
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Legal Rental Contracts collection
    match /contracts/{contractId} {
      allow read: if isEmployee() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Payments collection - creation & updates strictly managed via recordPaymentSecure Cloud Function
    match /payments/{paymentId} {
      allow read: if isEmployee() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /maintenanceRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    match /vehicleInspections/{inspectionId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /rateLimits_ip/{rateLimitId} {
      allow read, write: if false;
    }

    match /telegram_callbacks/{callbackId} {
      allow read, write: if false;
    }

    match /system_config/{configId} {
      allow read, write: if false;
    }
  }
}
